# Monitoring settings for dc-west. Used as: docker compose --env-file env/dc-west.env up -d
REGION=dc-west
# Containerlab management network for this region (created by containerlab deploy)
MGMT_NET=clab-netlab-west-mgmt
MGMT_PREFIX=10.254.255
# Services network (created by docker compose)
SVC_SUBNET=10.21.0.0/24
SVC_PREFIX=10.21.0
# Host ports bound to 127.0.0.1 (offset per region so all three can share one host)
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
BATFISH_PORT=10006
