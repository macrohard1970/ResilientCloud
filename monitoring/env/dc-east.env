# Monitoring settings for dc-east. Used as: docker compose --env-file env/dc-east.env up -d
REGION=dc-east
# Containerlab management network for this region (created by containerlab deploy)
MGMT_NET=clab-netlab-east-mgmt
MGMT_PREFIX=10.255.255
# Services network (created by docker compose)
SVC_SUBNET=10.20.0.0/24
SVC_PREFIX=10.20.0
# Host ports bound to 127.0.0.1 (offset per region so all three can share one host)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
BATFISH_PORT=9996
