# Monitoring settings for dc-eu. Used as: docker compose --env-file env/dc-eu.env up -d
REGION=dc-eu
# Containerlab management network for this region (created by containerlab deploy)
MGMT_NET=clab-netlab-eu-mgmt
MGMT_PREFIX=10.253.255
# Services network (created by docker compose)
SVC_SUBNET=10.22.0.0/24
SVC_PREFIX=10.22.0
# Host ports bound to 127.0.0.1 (offset per region so all three can share one host)
PROMETHEUS_PORT=9092
GRAFANA_PORT=3002
BATFISH_PORT=10016
